rules_version = '2';
/* SIST-ENDRET: 2026-08-20 02:20:00 */
service firebase.storage {
  match /b/{bucket}/o {

    // Lærer-/elevvedlegg — kun innloggede brukere.
    match /homework-submissions/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    match /message-attachments/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Kvitteringer og økonomi — kun innloggede (admin-panelet).
    match /finance-receipts/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Profilbilder for ansatte, foresatte og elever.
    match /person-photos/{allPaths=**} {
      allow read, write: if request.auth != null;
    }

    // Sikkerhetskopier skrives av Admin SDK — aldri fra klienten.
    match /backups/{allPaths=**} {
      allow read, write: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
