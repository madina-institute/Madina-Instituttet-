{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "sjekk-sider.mjs"
    ],
    "headers": [
      {
        "//": "🔴 Headers matcher REQUEST-stien, ikke filen som til slutt serveres.",
        "//2": "Regelen over gjelder **/*.@(html) — men ingen av de pene adressene",
        "//3": "har filendelse. /lærer traff derfor ingen regel og fikk Firebases",
        "//4": "standard mellomlagring på én time. Man publiserte, og telefonen",
        "//5": "fortsatte å vise gårsdagens fil — mens verktøyet sa «publisert»,",
        "//6": "og det stemte: filen LÅ ute. Det var nettleseren som ikke spurte.",
        "//7": "Derfor listes rutene her, én for én. De er de samme som i",
        "//8": "rewrites over — endres den listen, må denne følge med.",
        "source": "/@(datoer|program|priser|om-oss|team|portaler|påmelding|pamelding|lærer|laerer|foreldre|timeplan|kunngjøringer|kunngjoringer|personvern|brosjyre|medlemskap|laremidler|læremidler|kontor|ledelse|larerinnsyn|lærerinnsyn|foreldreinnsyn|slettelogg|statistikk|helsesjekk|publiser)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/datoer",
        "destination": "/datoer.html"
      },
      {
        "source": "/program",
        "destination": "/program.html"
      },
      {
        "source": "/priser",
        "destination": "/priser.html"
      },
      {
        "source": "/om-oss",
        "destination": "/om-oss.html"
      },
      {
        "source": "/team",
        "destination": "/team.html"
      },
      {
        "source": "/portaler",
        "destination": "/portaler.html"
      },
      {
        "source": "/påmelding",
        "destination": "/index2.html"
      },
      {
        "source": "/pamelding",
        "destination": "/index2.html"
      },
      {
        "source": "/lærer",
        "destination": "/index1.html"
      },
      {
        "source": "/laerer",
        "destination": "/index1.html"
      },
      {
        "source": "/foreldre",
        "destination": "/index4.html"
      },
      {
        "source": "/timeplan",
        "destination": "/timeplan.html"
      },
      {
        "source": "/kunngjøringer",
        "destination": "/kunngjoring.html"
      },
      {
        "source": "/kunngjoringer",
        "destination": "/kunngjoring.html"
      },
      {
        "source": "/personvern",
        "destination": "/personvern.html"
      },
      {
        "source": "/brosjyre",
        "destination": "/madina-brosjyre.html"
      },
      {
        "source": "/medlemskap",
        "destination": "/medlemskap.html"
      },
      {
        "source": "/laremidler",
        "destination": "/laremidler.html"
      },
      {
        "source": "/læremidler",
        "destination": "/laremidler.html"
      },
      {
        "source": "/kontor",
        "destination": "/admin.html"
      },
      {
        "source": "/ledelse",
        "destination": "/ledelseinnsyn.html"
      },
      {
        "source": "/larerinnsyn",
        "destination": "/larerinnsyn.html"
      },
      {
        "source": "/lærerinnsyn",
        "destination": "/larerinnsyn.html"
      },
      {
        "source": "/foreldreinnsyn",
        "destination": "/foreldreinnsyn.html"
      },
      {
        "source": "/slettelogg",
        "destination": "/slettelogg.html"
      },
      {
        "source": "/statistikk",
        "destination": "/statistikk.html"
      },
      {
        "source": "/helsesjekk",
        "destination": "/helsesjekk.html"
      },
      {
        "source": "/publiser",
        "destination": "/publish-tool.html"
      }
    ]
  }
}