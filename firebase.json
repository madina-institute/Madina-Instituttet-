{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "disallowLegacyRuntimeConfig": true,
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ]
    }
  ],
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "functions/**",
      "*.md",
      "sjekk-sider.mjs"
    ],
    "headers": [
      {
        "source": "**/*.@(html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.@(png|jpg|jpeg|gif|svg|webp|ico)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/priser",
        "destination": "/priser.html"
      },
      {
        "source": "/påmelding",
        "destination": "/index2.html"
      },
      {
        "source": "/pamelding",
        "destination": "/index2.html"
      },
      {
        "source": "/lærer",
        "destination": "/index1.html"
      },
      {
        "source": "/laerer",
        "destination": "/index1.html"
      },
      {
        "source": "/foreldre",
        "destination": "/index4.html"
      },
      {
        "source": "/timeplan",
        "destination": "/timeplan.html"
      },
      {
        "source": "/kunngjøringer",
        "destination": "/kunngjoring.html"
      },
      {
        "source": "/kunngjoringer",
        "destination": "/kunngjoring.html"
      },
      {
        "source": "/personvern",
        "destination": "/personvern.html"
      },
      {
        "source": "/brosjyre",
        "destination": "/madina-brosjyre.html"
      },
      {
        "source": "/medlemskap",
        "destination": "/medlemskap.html"
      },
      {
        "source": "/laremidler",
        "destination": "/laremidler.html"
      },
      {
        "source": "/læremidler",
        "destination": "/laremidler.html"
      },
      {
        "source": "/kontor",
        "destination": "/admin.html"
      },
      {
        "source": "/ledelse",
        "destination": "/ledelseinnsyn.html"
      },
      {
        "source": "/larerinnsyn",
        "destination": "/larerinnsyn.html"
      },
      {
        "source": "/lærerinnsyn",
        "destination": "/larerinnsyn.html"
      },
      {
        "source": "/foreldreinnsyn",
        "destination": "/foreldreinnsyn.html"
      },
      {
        "source": "/slettelogg",
        "destination": "/slettelogg.html"
      },
      {
        "source": "/statistikk",
        "destination": "/statistikk.html"
      },
      {
        "source": "/helsesjekk",
        "destination": "/helsesjekk.html"
      },
      {
        "source": "/publiser",
        "destination": "/publish-tool.html"
      }
    ]
  }
}