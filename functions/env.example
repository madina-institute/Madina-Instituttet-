# انسخ الملف ده وسمّيه .env (من غير .example) وحط فيه بياناتكم الحقيقية.
# ما تحطش هذا الملف على GitHub أبداً — هو للسيرفر بس.

# "test" وانتوا بتجربوا، "prod" لما تكونوا جاهزين فعلياً تستقبلوا فلوس حقيقية
VIPPS_ENV=test

# رقم المحل التجاري بتاعكم (Merchant Serial Number) — تلاقوه في بوابة Vipps
VIPPS_MSN=

# رابط موقعكم (سيبه زي ما هو غالباً)
SITE_BASE_URL=https://madina-institute.github.io/Madina-Instituttet-
