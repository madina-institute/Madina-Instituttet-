# Kopier til functions/.env (eller bruk Firebase Secret Manager for prod).
# IKKE commit .env-filer — de er ignorert av .gitignore.

# "test" mens dere prøver, "prod" når dere tar imot ekte betalinger
VIPPS_ENV=test

# Merchant Serial Number fra Vipps-portalen
VIPPS_MSN=

# Nettadressen til skolens nettside
SITE_BASE_URL=https://madinaskole.no

# Hemmeligheter (VIPPS_CLIENT_ID, VIPPS_CLIENT_SECRET, VIPPS_SUBSCRIPTION_KEY,
# VIPPS_WEBHOOK_SECRET) settes via:
#   firebase functions:secrets:set VIPPS_CLIENT_ID
# Se functions/README.md for full deploy-sjekkliste.
